default_platform(:ios)

WORKSPACE = "ios/App/App.xcworkspace"
SCHEME    = "App"

platform :ios do
  desc "Build and upload a TestFlight build"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    setup_ci

    # Epoch seconds: always unique, always increasing, safely under Apple's 2^32
    # per-component cap. (GITHUB_RUN_NUMBER restarts at 1 for a new workflow and
    # would collide with the build already on TestFlight.)
    build = Time.now.to_i.to_s
    increment_build_number(build_number: build, xcodeproj: "ios/App/App.xcodeproj")

    # xcodebuild needs the API key on disk to authenticate with Apple during
    # -allowProvisioningUpdates (gym's build_app has no api_key option).
    require "base64"
    asc_key_path = File.expand_path("fastlane_asc_api_key.p8")
    File.write(asc_key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
    asc_auth = "-allowProvisioningUpdates " \
               "-authenticationKeyPath #{asc_key_path} " \
               "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
               "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: asc_auth,
      export_xcargs: asc_auth,
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
