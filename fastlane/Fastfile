default_platform(:ios)

WORKSPACE = "ios/App/App.xcworkspace"
SCHEME    = "App"
XCODEPROJ = "ios/App/App.xcodeproj"
APP_ID    = "parkstatus.today.app"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  # One-time (and yearly-renewal) lane: create the App Store signing certificate
  # and provisioning profile, encrypt them with MATCH_PASSWORD, push to the
  # parkstatus-certs repo. Run via: workflow_dispatch with lane = "certs".
  desc "Create/refresh the App Store cert + profile in the match repo"
  lane :certs do
    setup_ci
    match(type: "appstore", app_identifier: APP_ID, api_key: asc_api_key, readonly: false)
  end

  desc "Build and upload a TestFlight build"
  lane :beta do
    api_key = asc_api_key
    setup_ci

    # Pull the shared cert + profile that the `certs` lane created. Read-only:
    # CI never creates or revokes signing assets, so it can't exhaust the
    # per-account certificate limit.
    match(type: "appstore", app_identifier: APP_ID, api_key: api_key, readonly: true)

    # Epoch seconds: unique, monotonic, safely under Apple's 2^32 per-component
    # cap. (GITHUB_RUN_NUMBER restarts at 1 for a new workflow.)
    increment_build_number(build_number: Time.now.to_i.to_s, xcodeproj: XCODEPROJ)

    update_code_signing_settings(
      path: XCODEPROJ,
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{APP_ID}"
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: { APP_ID => "match AppStore #{APP_ID}" }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
