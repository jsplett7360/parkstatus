default_platform(:ios)

WORKSPACE = "ios/App/App.xcworkspace"
SCHEME    = "App"

platform :ios do
  desc "Build and upload a TestFlight build"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    setup_ci

    build = (ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s)
    increment_build_number(build_number: build, xcodeproj: "ios/App/App.xcodeproj")

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
